{
  "bsonType": "object",
  "required": ["order_no", "user_id", "items", "total", "status", "payment_status", "created_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "数据库订单主键" },
    "order_no": { "bsonType": "string", "description": "展示给用户的订单号" },
    "user_id": { "bsonType": "string", "description": "微信 OPENID 或 H5/App 客户端稳定用户 ID" },
    "user_info": { "bsonType": "object", "description": "下单用户附加信息" },
    "address": { "bsonType": "object", "description": "收货地址快照" },
    "address_text": { "bsonType": "string", "description": "收货地址展示文本" },
    "items": { "bsonType": "array", "description": "订单商品快照" },
    "item_count": { "bsonType": "number", "description": "商品总件数" },
    "total": { "bsonType": "number", "description": "服务端计算的订单总额" },
    "status": { "bsonType": "string", "description": "订单状态" },
    "status_text": { "bsonType": "string", "description": "订单状态展示文字" },
    "payment_status": { "bsonType": "string", "description": "支付状态，创建订单时固定为 unpaid" },
    "payment_status_text": { "bsonType": "string", "description": "支付状态展示文字" },
    "created_at": { "bsonType": "number", "description": "创建时间戳" },
    "created_at_text": { "bsonType": "string", "description": "创建时间展示文本" },
    "updated_at": { "bsonType": "number", "description": "更新时间戳" }
  }
}