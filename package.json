{
  "name": "mori-shop",
  "version": "0.1.0",
  "private": true,
  "description": "MORI 木里 - uni-app 跨端生活方式商店前端",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit",
    "deploy:preview": "node scripts/preview-server.mjs",
    "test:cloud": "node scripts/test-cloud-domain.mjs",
    "test:e2e": "node scripts/e2e-check.mjs",
    "export:products": "node scripts/export-cloud-products.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030220261016001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030220261016001",
    "@vue/tsconfig": "0.5.1",
    "playwright-core": "^1.48.2",
    "sass": "1.77.8",
    "sharp": "0.33.5",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "2.0.29"
  }
